# ==============================================================
# Autonomous GitHub Issue Resolution Agent - Environment Config
# ==============================================================

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration
# Personal Access Token (classic with 'repo' scope or fine-grained token)
# Or GitHub App installation token
GITHUB_TOKEN=your-github-personal-access-token-here

# Webhook Secret (HMAC-SHA256 for GitHub webhooks)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Autonomous Mode (Set to true to bypass human approval gate before creating PRs)
# Default is false to enforce human review in dashboard
AUTONOMOUS_MODE=false

# Subprocess & Test Limits
MAX_TEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_BYTES=102400
MAX_FIX_ATTEMPTS=3

# Frontend API URL (for Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

